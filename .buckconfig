[cells]
    antlir = .
    prelude = prelude
    toolchains = toolchains
    none = none

[cell_aliases]
    config = prelude
    ovr_config = prelude
    fbcode = none
    fbsource = none
    fbcode_macros = none
    buck = none

[external_cells]
    prelude = bundled

[parser]
    target_platform_detector_spec = target:antlir//...->prelude//platforms:default

[project]
    ignore = antlir2-out, .git, .sl, .claude-persist

[buck2]
    # watchman is not installed in this sandbox; the notify (inotify) fallback
    # works now that fs.inotify.max_user_watches is raised and we avoid the
    # huge `generated` cell (fedora44 uses an empty repo set).
    file_watcher = notify

[build]
    execution_platforms = antlir//platforms:host

[http]
    # crates.io downloads time out at the default 5s under buck2's ~150-way
    # concurrent burst in this bandwidth-limited sandbox. Raise generously.
    connect_timeout_ms = 60000
    read_timeout_ms = 60000
    write_timeout_ms = 60000
