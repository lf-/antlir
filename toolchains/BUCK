load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain", "system_python_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")

# system_rust_toolchain doesn't expose rustc_env, so we use a local near-clone
# that sets RUSTC_BOOTSTRAP=1 (see :rust below).
load(":rust_bootstrap.bzl", "bootstrap_rust_toolchain")

"""
All the default toolchains, suitable for a quick demo or early prototyping.
Most real projects should copy/paste the implementation to configure them.
"""

system_cxx_toolchain(
    name = "cxx",
    cxx_flags = [
        "--std=c++17",
    ],
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_python_toolchain(
    name = "python",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

# RUSTC_BOOTSTRAP=1 (set inside bootstrap_rust_toolchain) opens nightly
# `#![feature(...)]` gates that many third-party crates request via cargo
# features, so we don't have to hand-strip those features out of the reindeer-
# generated third-party/rust/BUCK.
bootstrap_rust_toolchain(
    name = "rust",
    # antlir first-party crates use edition 2024 (let-chains, etc.; their
    # autocargo Cargo.tomls declare `edition = "2024"`). Third-party crates set
    # their own edition per-target in the reindeer-generated BUCK, so this
    # default only governs first-party targets that don't set one explicitly.
    default_edition = "2024",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

# TODO: get this from the cxx toolchain
sh_binary(
    name = "objcopy",
    main = "objcopy",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)
