load("//antlir/antlir2/build_appliance:defs.bzl", "build_appliance_from_dir")
load("//antlir/antlir2/bzl/flavor:defs.bzl", "flavor")
load("//antlir/antlir2/bzl/image:build_appliance.bzl", "build_appliance")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/bzl/package:defs.bzl", "package")
load("//antlir/bzl:build_defs.bzl", "buck_genrule", "export_file")

flavor(
    name = "fedora44",
    # Unlike centos{9,10}, we deliberately do NOT bake a `generated//` RPM
    # snapshot in as the default repo set (that cell is huge, x86_64-only, and
    # absent in OSS -- see BUGS.md #5). Images pull Fedora repos explicitly via
    # `dnf_additional_repos` (live mirror or a local snapshot).
    # Local Fedora 44 aarch64 snapshot (see repo/README.md). antlir2 dnf is
    # fully offline, so the BA's dnf stack + closure must be materialized as
    # in-repo rpm() targets rather than pulled live.
    default_dnf_repo_set = "fedora44//:repos",
    default_dnf_versionlock = "//antlir/antlir2/package_managers/dnf/build_appliance:empty-dnf-versionlock.json",
    visibility = ["PUBLIC"],
)

_S3_BUCKET = "https://axq7lorgquqs.objectstorage.ca-montreal-1.oci.customer-oci.com/n/axq7lorgquqs/b/fedora.jade.fyi/o/"

# The build appliance tarball is built on a Fedora with
# flavor/bootstrap/build_appliance.py.
alias(
    name = "build-appliance.tar.zst",
    actual = select({
        "ovr_config//cpu:arm64": ":build-appliance-aarch64",
        "ovr_config//cpu:x86_64": ":build-appliance-x86_64",
    }),
)

http_file(
    name = "build-appliance-x86_64",
    urls = [_S3_BUCKET + "bootstrap/fedora44_ba_x86_64-20260719.tar.zst"],
    sha256 = "c073000fcf78e30c7b00dbbb08137f2ce037ee381817076c9afad21c402fff20",
    size_bytes = 49774854,
)

http_file(
    name = "build-appliance-aarch64",
    urls = [_S3_BUCKET + "bootstrap/fedora44_ba_aarch64-20260719.tar.zst"],
    sha256 = "74aab0a259a919efdfcf41a16b08daca9532640284f127aba8c10ede87c4d54e",
    size_bytes = 46070977,
)

# BuildApplianceInfo.dir must be a *plain directory* rootfs, not the tarball
# (the isolation bind-mounts it as the root layer -> a file gives ENOTDIR). Per
# the provider docs, ownership/fs-metadata don't matter for a BA, so a plain
# unprivileged `tar x` is fine (the seed tarball contains no device nodes).
buck_genrule(
    name = "build-appliance.rootfs",
    out = "rootfs",
    cmd = """
        mkdir -p "$OUT"
        zstd -dc $(location :build-appliance.tar.zst) | tar -C "$OUT" -xf -
        # antlir2 hardcodes /usr/libexec/platform-python (a CentOS/RHEL-ism) as
        # the in-BA interpreter for e.g. the rpm fact-finder
        # (antlir2_facts/update_db.rs). Fedora ships /usr/bin/python3 but never
        # creates that symlink, so provide it here to match CentOS BAs.
        mkdir -p "$OUT/usr/libexec"
        ln -sf ../bin/python3 "$OUT/usr/libexec/platform-python"
    """,
)

build_appliance(
    name = "build-appliance.prebuilt",
    # NOT `:build-appliance.tar.zst` -- that alias resolves to an `http_file`,
    # i.e. the literal tarball. centos9/10 get away with pointing `src` at their
    # `.tar.zst` target only because theirs is an `http_archive`, which buck
    # extracts for them. See the note on `:build-appliance.rootfs` above.
    src = ":build-appliance.rootfs",
    visibility = [
        "antlir//antlir/antlir2/flavor:none",
    ],
)

image.layer(
    name = "build-appliance.layer",
    build_appliance = ":build-appliance.prebuilt",
    # Pin to the fedora44 flavor (empty repo set). Without this the layer
    # inherits the repo-wide default OS (centos9), whose flavor hard-depends on
    # the huge `generated//` RPM snapshot cell -- see BUGS.md #5. The explicit
    # build_appliance above (the bootstrapped seed) breaks the would-be cycle,
    # exactly as centos9's own BA layer relies on an explicit prebuilt.
    default_os = "fedora44",
    # antlir2's default `btrfs` working format needs a btrfs filesystem under
    # antlir2-out/subvols. This host now has a btrfs kernel; `setup.sh
    # step_btrfs` mounts a loopback btrfs there (with user_subvol_rm_allowed),
    # and rootless subvolume create/delete works in that userns. If you ever run
    # on a btrfs-less host, set `working_format = "cad-stack"` here instead — it
    # materializes into a plain TempDir + content-addressed object store (the
    # antlir2_btrfs Subvolume::create plain-dir fallback covers the final
    # materialize-to-subvol step there too).
    features = [
        "//antlir/antlir2/build_appliance:features",
    ],
)

package.unprivileged_dir(
    name = "build-appliance.dir",
    # Must be explicit: the default for this attr is the OS-selected build
    # appliance, which for fedora44 is `:build-appliance` -- i.e. this target's
    # own consumer, a target-graph cycle. The bootstrapped seed breaks it.
    build_appliance = ":build-appliance.prebuilt",
    layer = ":build-appliance.layer",
)

# THIS is what `OSES[].build_appliance` must point at. An `image.layer` only
# provides LayerInfo; the `build_appliance` attr is an `attrs.exec_dep(providers
# = [BuildApplianceInfo])`, and layers stopped providing BuildApplianceInfo in
# D55970042 ("untangling of layers and build appliances"). Matches the shape of
# the fb-internal `images/build_appliance/<os>:build-appliance` targets and of
# `antlir2_packager:packager-appliance.impl`.
build_appliance_from_dir(
    name = "build-appliance",
    dir = ":build-appliance.dir",
    visibility = ["PUBLIC"],
)

buck_genrule(
    name = "build-appliance.impl.tar.zst",
    cmd = """
        tar -cf $TMP/ba.tar -C $(location :build-appliance.dir) .
        zstd $TMP/ba.tar -o $OUT
    """,
)
